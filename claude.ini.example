# Claude for PS4 settings.
# Easiest: press Options in the app and fill in the page on your phone.
# Or copy this file to /data/claude/claude.ini on the PS4 (GoldHEN FTP), or to
# the root of a USB drive as claude.ini. The app reads the first one it finds:
# /data/claude, /mnt/usb0, /mnt/usb1, /data.

# api = use an API key, bridge = use your Claude account through claude-bridge.py on a PC
mode=api

# Your Anthropic API key (console.anthropic.com). Needed for mode=api.
api_key=sk-ant-REPLACE-ME

# For mode=bridge: the address and pairing code that claude-bridge.py prints.
bridge_url=
bridge_token=

# Model in API key mode: claude-opus-5-5 (default), claude-sonnet-5-5,
# claude-haiku-5-5, claude-fable-5-2, claude-opus-5. You can also pick it on the PS4 with R2.
model=claude-opus-5-5

# Model in PC bridge mode: default (whatever Claude Code uses), opus, sonnet, haiku, fable,
# or a full model id.
bridge_model=default

# Longest reply in tokens. Default: 16000
max_tokens=16000

# Reasoning effort: low, medium, high, xhigh, max. Empty = API default (medium on Opus 5.5).
# low is faster and cheaper for plain chat.
effort=

# Custom system prompt. Use \n for a new line. Leave out to use the built-in one.
# system=You are a helpful assistant.

# Verify the api.anthropic.com certificate. Keep 1. Set 0 only if every
# request fails with an SSL error because the PS4 certificate store is too old.
# With 0 your API key could be read by anyone who can intercept your network.
tls_verify=1

# Server-side fallback model when a request is declined: auto, 1 or 0.
fallbacks=auto
